# 自用Clash配置文件，可实现订阅链接和规则分开管理，引用订阅链接和外部规则集。
mixed-port: 7890
allow-lan: true
bind-address: '*'
mode: rule
log-level: info
external-controller: '127.0.0.1:9090'

dns:
  enable: true
  ipv6: true
  default-nameserver: [223.5.5.5, 119.29.29.29]
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  use-hosts: true
  nameserver: ['https://doh.pub/dns-query', 'https://dns.alidns.com/dns-query']
  fallback: ['https://doh-pure.onedns.net/dns-query', 'https://ada.openbld.net/dns-query', 'https://223.5.5.5/dns-query', 'https://223.6.6.6/dns-query', 'https://doh.dns.sb/dns-query', 'https://dns.cloudflare.com/dns-query', 'https://dns.twnic.tw/dns-query', 'tls://8.8.4.4:853']
  fallback-filter: { geoip: true, ipcidr: [240.0.0.0/4, 0.0.0.0/32] }

# -------------------------------------------------------------------
# 多节点订阅源配置（本文件以双机场示例，根据实际需求可再增加机场数量），url内填入自用机场的订阅链接，interval填入自动更新时间（秒）
# -------------------------------------------------------------------
proxy-providers:
  Airport1:
    type: http
    url: "此处填入你的机场1订阅链接"
    interval: 86400
    path: ./providers/airport1.yaml
    health-check:
      enable: true
      interval: 600
      url: http://www.gstatic.com/generate_204

  Airport2:
    type: http
    url: "此处填入你的机场2订阅链接"
    interval: 86400
    path: ./providers/airport2.yaml
    health-check:
      enable: true
      interval: 600
      url: http://www.gstatic.com/generate_204

# -------------------------------------------------------------------
# 策略组配置（同时使用多个订阅源），本文件以双机场示例，根据实际需求可再增加机场数量
# -------------------------------------------------------------------
proxy-groups:
  # 默认的代理策略
  - name: 默认策略
    type: select
    proxies: [香港, 澳门, 新加坡, 台湾, 日本, 美国, Airport1, Airport2, 全部节点]

  # TG的代理策略
  - name: Telegram
    type: select
    proxies: [香港, 澳门, 新加坡, 台湾, 日本, 美国]

  # 微软Copilot代理策略
  - name: MS&Copilot
    type: select
    proxies: [香港, 澳门, 新加坡, 台湾, 日本, 美国]

  # AI（GPT、Gemini的代理策略）
  - name: AI
    type: select
    proxies: [新加坡, 台湾, 日本, 美国]

  # STEAM的代理策略
  - name: STEAM
    type: select
    proxies: [DIRECT, 香港, 澳门, 新加坡, 台湾, 日本, 美国]

  # 哔哩哔哩港澳台&巴哈姆特动画疯
  - name: 海外动画
    type: select
    proxies: [香港, 澳门, 台湾]

  # 网飞节点
  - name: Netflix
    type: select
    proxies: [香港, 澳门, 新加坡, 台湾, 日本, 美国]

  # -------------------------------------------------------------------
  # 地区策略组：同时汇总 Airport1 和 Airport2 的对应节点，并自动测速选优
  # -------------------------------------------------------------------
  - name: 香港
    type: url-test
    use:
      - Airport1
      - Airport2
    filter: "(?i)港|HK|HongKong|Hong Kong"
    url: 'http://www.gstatic.com/generate_204'
    interval: 300
    timeout: 5000
    max-failed-times: 5
    lazy: true

  - name: 澳门
    type: url-test
    use:
      - Airport1
      - Airport2
    filter: "(?i)澳门|Macau|Macao|\\bMO\\b"
    url: 'http://www.gstatic.com/generate_204'
    interval: 300
    timeout: 5000
    max-failed-times: 5
    lazy: true

  - name: 新加坡
    type: url-test
    use:
      - Airport1
      - Airport2
    filter: "(?i)新|坡|SG|Singapore"
    url: 'http://www.gstatic.com/generate_204'
    interval: 300
    timeout: 5000
    max-failed-times: 5
    lazy: true

  - name: 台湾
    type: url-test
    use:
      - Airport1
      - Airport2
    filter: "(?i)台|TW|Taiwan"
    url: 'http://www.gstatic.com/generate_204'
    interval: 300
    timeout: 5000
    max-failed-times: 5
    lazy: true

  - name: 日本
    type: url-test
    use:
      - Airport1
      - Airport2
    filter: "(?i)日|川|JP|Japan"
    url: 'http://www.gstatic.com/generate_204'
    interval: 300
    timeout: 5000
    max-failed-times: 5
    lazy: true

  - name: 美国
    type: url-test
    use:
      - Airport1
      - Airport2
    filter: "(?i)美|波特兰|达拉斯|俄勒冈|US|United States"
    url: 'http://www.gstatic.com/generate_204'
    interval: 300
    timeout: 5000
    max-failed-times: 5
    lazy: true

  # -------------------------------------------------------------------
  # 订阅源相关策略组
  # -------------------------------------------------------------------
  # 第一个机场节点自动选优
  - name: Airport1
    type: url-test
    use:
      - Airport1
    url: 'http://www.gstatic.com/generate_204'
    interval: 300
    timeout: 5000
    lazy: true

  # 第二个机场节点自动选优
  - name: Airport2
    type: url-test
    use:
      - Airport2
    url: 'http://www.gstatic.com/generate_204'
    interval: 300
    timeout: 5000
    lazy: true

  # 展示两个订阅源下所有具体节点的选择策略组
  - name: 全部节点
    type: select
    use:
      - Airport1
      - Airport2

