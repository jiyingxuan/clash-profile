# -------------------------------------------------------------------
# 代理规则（按优先顺序从上到下匹配）
# -------------------------------------------------------------------
rules:
  # 局域网/局域设备直连
  - 'GEOIP,LAN,DIRECT'

  # 自定义规则
  - 'DOMAIN-KEYWORD,doubao,DIRECT'
  - 'DOMAIN,generativelanguage.googleapis.com,AI'

  # 3. 引用外部规则集 (Rule-Set)
  - 'RULE-SET,China_Rule,DIRECT'
  - 'RULE-SET,WeChat_Rule,DIRECT'
  - 'RULE-SET,DingTalk_Rule,DIRECT'
  - 'RULE-SET,DouYin_Rule,DIRECT'
  - 'RULE-SET,Zhihu_Rule,DIRECT'
  - 'RULE-SET,Copilot_Rule,MS&Copilot'
  - 'RULE-SET,Gemini_Rule,AI'
  - 'RULE-SET,OpenAI_Rule,AI'
  - 'RULE-SET,Telegram_Rule,Telegram'
  - 'RULE-SET,Netflix_Rule,Netflix'
  - 'RULE-SET,DMM_Rule,日本'
  - 'RULE-SET,Bahamut_Rule,海外动画'
  - 'RULE-SET,BiliBiliIntl_Rule,海外动画'
  - 'RULE-SET,Steam_Rule,STEAM'
  - 'RULE-SET,SteamCN_Rule,DIRECT'

  # steam 下载接入点补充
  - 'DOMAIN-SUFFIX,steamcontent.com,STEAM'

  # 国内 IP 直连兜底
  - 'GEOIP,CN,DIRECT'

  # 最终兜底规则
  - 'MATCH,默认策略'
